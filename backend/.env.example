# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=reconlens

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# VirusTotal API v3 (free key)
VT_API_KEY=
# NVD API 2.0 key (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Exact origin of the frontend (comma-separate several)
FRONTEND_ORIGIN=http://localhost:5173
DAILY_SCAN_LIMIT=10

# Proxies in front of the app that append to X-Forwarded-For (Render: 1)
TRUSTED_PROXY_HOPS=1
